{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["format", "version", "title", "viewport", "slides"],
    "properties": {
        "format": { "const": "web-deck" },
        "version": { "const": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
                "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
                "height": { "type": "integer", "minimum": 240, "maximum": 4320 }
            }
        },
        "externalResources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "imageHosts": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^(?=.{1,253}$)(?!-)(?:[a-zA-Z0-9-]{1,63}\\.)*[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$"
                    },
                    "uniqueItems": true
                },
                "fontStylesheetHosts": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^(?=.{1,253}$)(?!-)(?:[a-zA-Z0-9-]{1,63}\\.)*[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$"
                    },
                    "uniqueItems": true
                },
                "fontHosts": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^(?=.{1,253}$)(?!-)(?:[a-zA-Z0-9-]{1,63}\\.)*[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$"
                    },
                    "uniqueItems": true
                }
            }
        },
        "slides": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "source"],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]+$",
                        "maxLength": 80
                    },
                    "title": { "type": "string", "maxLength": 160 },
                    "source": { "type": "string", "minLength": 1 },
                    "notes": { "type": "string", "minLength": 1 }
                }
            }
        }
    }
}
