{
    "name": "armadillo-pp-in-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "predev": "npm run compile:catalog-diagrams && npm run vendor:pptx",
        "dev": "node server/main-dev.js",
        "start": "node server/main-prod.js",
        "prebuild": "npm run compile:catalog-diagrams && npm run vendor:pptx",
        "build": "vite build",
        "lint": "eslint .",
        "vendor:chart": "node scripts/vendor-chart-runtime.mjs",
        "vendor:icons": "node scripts/vendor-icons.mjs",
        "vendor:pptx": "node scripts/vendor-pptx-runtime.mjs",
        "compile:catalog-diagrams": "node scripts/compile-catalog-diagrams.mjs",
        "compile:diagrams": "node scripts/compile-diagrams.mjs",
        "package:deck": "node scripts/package-deck.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "ajv": "^8.17.1",
        "chart.js": "^4.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dom-to-pptx": "2.1.2",
        "echarts": "^6.0.0",
        "fflate": "^0.8.2",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.49.0",
        "radix-ui": "^1.6.7",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.18.4",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@phosphor-icons/core": "2.1.1",
        "@playwright/test": "^1.55.0",
        "@vitejs/plugin-react": "^5.0.2",
        "eslint": "^9.35.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^6.1.1",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.3.0",
        "mermaid": "11.17.2",
        "prettier": "^3.6.2",
        "vite": "^7.1.5",
        "vitest": "^5.0.1"
    },
    "packageManager": "npm@10.9.2",
    "overrides": {
        "pptxgenjs": {
            "image-size": "2.0.4"
        }
    }
}
